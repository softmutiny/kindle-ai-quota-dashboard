{
  "name": "kindle-ai-quota-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "把本机 AI 服务额度安全地显示在越狱 Kindle 上。",
  "license": "MIT",
  "author": "Kindle AI Quota Dashboard contributors",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "demo": "node src/collect.cjs --demo",
    "collect": "node src/collect.cjs",
    "weather": "node scripts/fetch-weather.cjs",
    "build": "node scripts/build-site.cjs",
    "serve": "node scripts/serve.cjs",
    "package:kindle": "node scripts/build-kpkg.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check-public.cjs && node --test tests/*.test.cjs"
  }
}
